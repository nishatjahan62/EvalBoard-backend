{
  "name": "evalboard-backend",
  "version": "1.0.0",
  "private": true,
  "description": "EvalBoard project submission and review REST API",
  "type": "module",
  "main": "dist/server.js",
  
"scripts": {
  "build": "prisma generate && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
  "dev": "tsx watch src/index.ts",
"start": "node dist/index.js",
  "typecheck": "tsc --noEmit",
  "db:generate": "prisma generate",
  "db:migrate": "prisma migrate dev",
  "db:seed": "tsx prisma/seed.ts"
},

  "dependencies": {
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "prisma": "^7.10.1",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
